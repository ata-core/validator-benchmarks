{
  "name": "validator-benchmarks",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ata-validator/native-darwin-arm64": "^1.61.3",
    "@cfworker/json-schema": "4.1.1",
    "@exodus/schemasafe": "1.3.0",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ata-validator": "^1.61.3",
    "fastest-validator": "1.19.1",
    "valibot": "1.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "ffmpeg-static": "5.2.0",
    "playwright": "1.50.1",
    "ttsc": "^0.34.1",
    "typescript": "7.0.2",
    "typia": "^15.2.2",
    "wrangler": "4.149.0"
